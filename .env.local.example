# Copy this file to .env.local and fill in your Firebase project's values.
# .env.local is gitignored and must never be committed.
#
# Find these values in the Firebase console under:
#   Project Settings → Your apps → SDK setup and configuration → Config
#
# The app runs in local-only mode (no auth, no cloud sync) when this file
# is absent or any of the four required keys are empty.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional — fill in for a complete Firebase project setup
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
